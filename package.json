{
  "name": "@digitalwalletcorp/image-context",
  "version": "0.1.0",
  "description": "A lightweight TypeScript utility class for easy image handling, format conversion, and transformation in browser applications.",
  "type": "module",
  "main": "lib/index.cjs",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      },
      "require": {
        "types": "./lib/index.d.cts",
        "default": "./lib/index.cjs"
      }
    },
    "./*": {
      "import": {
        "types": "./lib/*.d.ts",
        "default": "./lib/*.js"
      },
      "require": {
        "types": "./lib/*.d.cts",
        "default": "./lib/*.cjs"
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "yarn:dedupe": "npx yarn-deduplicate --strategy highest yarn.lock",
    "install:dev": "rm -rf lib dest && find node_modules -mindepth 1 -delete && yarn install",
    "tsc": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "prepack": "rm -rf lib && npm run build",
    "pack": "rm -rf dest && mkdir -p dest && npm pack --pack-destination=dest",
    "publish:npm": "bash ../bin/publish.sh",
    "test:unit": "vitest run --coverage"
  },
  "keywords": [
    "image",
    "resize",
    "rotate",
    "dataurl",
    "base64",
    "browser"
  ],
  "author": "Digital Wallet Corporation",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digitalwalletcorp/image-context.git"
  },
  "homepage": "https://github.com/digitalwalletcorp/image-context",
  "bugs": {
    "url": "https://github.com/digitalwalletcorp/image-context/issues"
  },
  "files": [
    "lib/**/*",
    "src/**/*"
  ],
  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.13.6",
    "@vitest/browser": "3.2.4",
    "@vitest/coverage-v8": "3.2.4",
    "eslint": "10.11.0",
    "globals": "17.13.0",
    "playwright": "1.62.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "7.3.6",
    "vite-plugin-dts": "5.1.0",
    "vitest": "3.2.4"
  },
  "resolutions": {
    "eslint": "10.11.0",
    "typescript-eslint": "8.71.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "globals": "17.13.0"
  }
}
